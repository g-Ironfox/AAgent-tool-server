# tool_server 独立运行配置示例
#
# 复制为 .env 后即可生效(compose 会自动读取同目录下的 .env)：
#   Copy-Item .env.example .env        # PowerShell
#
# .env 已被 .gitignore 与 .dockerignore 忽略，不会提交、也不会被打进镜像。
# 所有键都有默认值，不创建 .env 也能直接 docker compose up。

# ---- 宿主机端口 ----
# Tool Server 暴露给宿主机的端口。与完整平台 stack 同时运行时必须换掉(平台默认也占 8083)。
TOOL_SERVER_PORT=8083

# ---- Redis(本 stack 自带) ----
REDIS_PASSWORD=
REDIS_DB=0

# ---- MongoDB(本 stack 自带) ----
# 留空表示不启用认证；仅在数据卷为空(首次启动)时初始化生效。
MONGO_USER=
MONGO_PASS=
MONGO_DATABASE=agent
MONGO_TOOL_TASK_LOG_COLLECTION=tool_task_logs

# ---- 任务调度 ----
TOOL_TASK_TTL_SECONDS=86400
TOOL_MAX_WAIT_MS=30000
TOOL_DISPATCH_TIMEOUT_SECONDS=5
TOOL_CALLBACK_EVENT_TYPES=async_result

# ---- 其他 ----
TZ=Asia/Shanghai
